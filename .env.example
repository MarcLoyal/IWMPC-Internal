# Copy to server/.env for local development.
# On Vercel, set these in Project Settings > Environment Variables.

# Database. On Supabase use the "Transaction pooler" URL (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iwmpc_dev"
# Direct connection, used only for migrations. On Supabase use the "Session pooler" / direct URL (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/iwmpc_dev"

# Long random text used to sign logins. Generate with: openssl rand -hex 32
JWT_SECRET="change-me"

# First admin user, created once when the users table is empty.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Sample data (Filipino names, sample payments). Only ever set this on Preview, never Production.
SEED_SAMPLE_DATA="false"

# Private storage for signature images (optional; without these they are kept in the database).
# Use the new secret key (sb_secret_...) or the legacy service_role key. Server-side only.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
