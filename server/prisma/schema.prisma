generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CASHIER
  STAFF
  BOARD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  NONE
  PENDING
  MEMBER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

enum ConnectionStatus {
  PENDING_INSTALLATION
  ACTIVE
  DISCONNECTED
}

// Loan Payment is added in Phase 1C.
enum PaymentType {
  WATER_BILL
  INSTALLATION_FEE
  MEMBERSHIP_FEE
  SHARE_CAPITAL
  RICE_LPG
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum BoardDecision {
  APPROVED
  DISAPPROVED
}

enum PaymentStatus {
  ACTIVE
  VOID
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  accountsCreated Account[]
  paymentsCreated Payment[]  @relation("PaymentCreatedBy")
  paymentsVoided  Payment[]  @relation("PaymentVoidedBy")
  auditLogs       AuditLog[]
  priceChanges    PriceChange[]
  salesCreated    Sale[]     @relation("SaleCreatedBy")

  @@map("users")
}

model Area {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  accounts Account[]

  @@map("areas")
}

model Account {
  id            Int     @id @default(autoincrement())
  accountNumber String  @unique @map("account_number")
  // Kept even if the person stops being a member, so the number is never reused.
  memberNumber  String? @unique @map("member_number")
  // Name as written on IWMPC's forms. full_name is built from these and used for search and display.
  lastName      String  @default("") @map("last_name")
  firstName     String  @default("") @map("first_name")
  middleName    String  @default("") @map("middle_name")
  fullName      String  @map("full_name")
  // Address as written on IWMPC's forms. address is built from these.
  purok         String  @default("")
  barangay      String  @default("")
  municipality  String  @default("")
  province      String  @default("")
  address       String  @default("")
  areaId        Int     @map("area_id")
  phone         String  @default("")
  birthDate     DateTime?    @map("birth_date") @db.Date
  civilStatus   CivilStatus? @map("civil_status")
  idType        String  @default("") @map("id_type")
  idNumber      String  @default("") @map("id_number")
  tin           String  @default("")
  sex           Sex?
  religion      String  @default("")
  education     String  @default("")

  // From the Application for Membership form. Filled in by "Make a Member".
  membershipAppliedOn DateTime?      @map("membership_applied_on") @db.Date
  membershipPurpose   String         @default("") @map("membership_purpose")
  sharesSubscribed    Int?           @map("shares_subscribed")
  sharesAmount        Decimal?       @map("shares_amount") @db.Decimal(12, 2)
  meterRegisteredName String         @default("") @map("meter_registered_name")
  pmesAttended        Boolean?       @map("pmes_attended")
  boardDecision       BoardDecision? @map("board_decision")
  boardDecisionDate   DateTime?      @map("board_decision_date") @db.Date

  // Changed only by the membership service (Make a Member + membership fee payment).
  isMember         Boolean          @default(false) @map("is_member")
  membershipStatus MembershipStatus @default(NONE) @map("membership_status")
  memberSince      DateTime?        @map("member_since") @db.Date
  membershipClass  String?          @map("membership_class")

  createdAt   DateTime @default(now()) @map("created_at")
  createdById Int?     @map("created_by")

  area          Area              @relation(fields: [areaId], references: [id])
  createdBy     User?             @relation(fields: [createdById], references: [id])
  beneficiaries Beneficiary[]
  connections   WaterConnection[]
  payments      Payment[]
  sales         Sale[]

  @@index([fullName])
  @@index([areaId])
  @@map("accounts")
}

model Beneficiary {
  id           Int    @id @default(autoincrement())
  accountId    Int    @map("account_id")
  name         String
  relationship String @default("")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model WaterConnection {
  id               Int              @id @default(autoincrement())
  accountId        Int              @map("account_id")
  // The system's own reference (C-00001). Staff never type or see it.
  connectionNumber String           @unique @map("connection_number")
  // From the water connection application (Form No. 2-A).
  applicationDate  DateTime?        @map("application_date") @db.Date
  // The meter's brand, e.g. "Meco" (the "Pangalan" of the meter on the form).
  meterName        String           @default("") @map("meter_name")
  meterSerial      String           @default("") @map("meter_serial")
  remarks          String           @default("")
  address          String           @default("")
  // RESIDENTIAL (Residential & Institutional) or COMMERCIAL (Commercial & Industrial)
  rateClass        String           @default("RESIDENTIAL") @map("rate_class")
  // What the meter showed when it was installed. The first bill counts from here.
  initialReading   Int              @default(0) @map("initial_reading")
  installationDate DateTime?        @map("installation_date") @db.Date
  status           ConnectionStatus @default(PENDING_INSTALLATION)
  createdAt        DateTime         @default(now()) @map("created_at")

  account  Account        @relation(fields: [accountId], references: [id])
  payments Payment[]
  readings MeterReading[]
  bills    WaterBill[]

  @@index([accountId])
  @@map("water_connections")
}

// One version of the tariff for one rate class. Changing the rates adds a new version with a
// later "effective from" month; old versions are never edited, so past bills are not affected.
model RateSchedule {
  id              Int      @id @default(autoincrement())
  rateClass       String   @map("rate_class")
  // First billing month (YYYY-MM) this version applies to.
  effectiveFrom   String   @map("effective_from")
  minimumCharge   Decimal  @map("minimum_charge") @db.Decimal(12, 2)
  minimumCoversM3 Int      @map("minimum_covers_m3")
  // [{ "upTo": 10, "rate": "19.50" }, ..., { "upTo": null, "rate": "31.90" }]
  tiers           Json
  // BLOCK: every cu.m above the minimum is charged at the rate of the block the total falls in.
  // PROGRESSIVE: each block is charged at its own rate.
  method          String   @default("BLOCK")
  note            String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  createdById     Int?     @map("created_by")

  bills WaterBill[]

  @@unique([rateClass, effectiveFrom])
  @@map("rate_schedules")
}

model MeterReading {
  id              Int      @id @default(autoincrement())
  connectionId    Int      @map("connection_id")
  period          String // YYYY-MM
  previousReading Int      @map("previous_reading")
  currentReading  Int      @map("current_reading")
  readDate        DateTime @map("read_date") @db.Date
  enteredById     Int      @map("entered_by")
  createdAt       DateTime @default(now()) @map("created_at")

  connection WaterConnection @relation(fields: [connectionId], references: [id])
  bill       WaterBill?

  @@unique([connectionId, period])
  @@map("meter_readings")
}

// The amounts are fixed when the bill is created. Later rate or penalty changes do not touch them.
model WaterBill {
  id             Int       @id @default(autoincrement())
  connectionId   Int       @map("connection_id")
  readingId      Int       @unique @map("reading_id")
  period         String // YYYY-MM
  cubicMeters    Int       @map("cubic_meters")
  amount         Decimal   @db.Decimal(12, 2)
  // Added to the bill only if it is not paid in full on or before the due date.
  penaltyAmount  Decimal   @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  billDate       DateTime  @map("bill_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  rateScheduleId Int       @map("rate_schedule_id")
  // Date the bill became fully paid; empty while anything is still owed. Kept up to date
  // whenever a payment is saved or voided.
  settledOn      DateTime? @map("settled_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  connection   WaterConnection @relation(fields: [connectionId], references: [id])
  reading      MeterReading    @relation(fields: [readingId], references: [id])
  rateSchedule RateSchedule    @relation(fields: [rateScheduleId], references: [id])
  payments     Payment[]

  @@unique([connectionId, period])
  @@index([settledOn])
  @@index([period])
  @@map("water_bills")
}

// ---- Rice & LPG (Phase 2) ---------------------------------------------------------------------

// Something sold at the Cashier, e.g. "Dinorado" or "LPG". Managed by an Admin in Settings.
model Product {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  units ProductUnit[]

  @@map("products")
}

// A way a product is sold, with its price: "per kilo", "per sack (25 kg)", "per 11 kg tank".
model ProductUnit {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  label       String
  price       Decimal  @db.Decimal(12, 2)
  // Optional lower price for members. Empty = members pay the same price.
  memberPrice Decimal? @map("member_price") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)

  product      Product       @relation(fields: [productId], references: [id])
  priceChanges PriceChange[]
  saleItems    SaleItem[]

  @@unique([productId, label])
  @@map("product_units")
}

// Every price change: old price, new price, who, when and why. Never edited or deleted.
model PriceChange {
  id             Int      @id @default(autoincrement())
  productUnitId  Int      @map("product_unit_id")
  oldPrice       Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice       Decimal  @map("new_price") @db.Decimal(12, 2)
  oldMemberPrice Decimal? @map("old_member_price") @db.Decimal(12, 2)
  newMemberPrice Decimal? @map("new_member_price") @db.Decimal(12, 2)
  reason         String
  changedById    Int?     @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at")

  unit      ProductUnit @relation(fields: [productUnitId], references: [id])
  changedBy User?       @relation(fields: [changedById], references: [id])

  @@index([productUnitId])
  @@map("price_changes")
}

// One Rice & LPG sale. A cash sale has one payment (one OR number) made with it. A credit sale
// (only when "Allow credit" is on) has no payment yet; payments are recorded later.
model Sale {
  id         Int           @id @default(autoincrement())
  // Empty for a walk-in customer.
  accountId  Int?          @map("account_id")
  walkInName String        @default("") @map("walk_in_name")
  saleDate   DateTime      @map("sale_date") @db.Date
  total      Decimal       @db.Decimal(12, 2)
  isCredit   Boolean       @default(false) @map("is_credit")
  // Date the sale became fully paid. Empty while a credit sale still has a balance.
  settledOn  DateTime?     @map("settled_on") @db.Date
  status     PaymentStatus @default(ACTIVE)
  voidReason String?       @map("void_reason")
  voidedAt   DateTime?     @map("voided_at")
  voidedById Int?          @map("voided_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  createdById Int          @map("created_by")

  account   Account?   @relation(fields: [accountId], references: [id])
  createdBy User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items     SaleItem[]
  payments  Payment[]

  @@index([accountId])
  @@index([saleDate])
  @@map("sales")
}

// One line of a sale. The names and the price are copied in at the time of sale, so renaming a
// product or changing its price later never changes what was sold.
model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int     @map("sale_id")
  productUnitId Int     @map("product_unit_id")
  productName   String  @map("product_name")
  unitLabel     String  @map("unit_label")
  quantity      Decimal @db.Decimal(12, 2)
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2)

  sale Sale        @relation(fields: [saleId], references: [id])
  unit ProductUnit @relation(fields: [productUnitId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  // Empty only for a walk-in Rice & LPG sale.
  accountId   Int?          @map("account_id")
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  // From IWMPC's own receipt booklet. Entered by hand, required, never reused.
  orNumber    String        @unique @map("or_number")
  // Calendar date in Asia/Manila.
  paymentDate DateTime      @map("payment_date") @db.Date
  // Installation fees are linked to the connection they paid for.
  connectionId Int?         @map("connection_id")
  waterBillId  Int?         @map("water_bill_id")
  saleId       Int?         @map("sale_id")
  description String        @default("")
  status      PaymentStatus @default(ACTIVE)
  voidReason  String?       @map("void_reason")
  voidedAt    DateTime?     @map("voided_at")
  voidedById  Int?          @map("voided_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById Int           @map("created_by")

  account    Account?         @relation(fields: [accountId], references: [id])
  sale       Sale?            @relation(fields: [saleId], references: [id])
  connection WaterConnection? @relation(fields: [connectionId], references: [id])
  waterBill  WaterBill?       @relation(fields: [waterBillId], references: [id])
  createdBy  User             @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy   User?            @relation("PaymentVoidedBy", fields: [voidedById], references: [id])

  @@index([accountId])
  @@index([paymentDate])
  @@index([waterBillId])
  @@index([saleId])
  @@map("payments")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
