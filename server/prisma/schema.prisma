generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CASHIER
  STAFF
  BOARD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  NONE
  PENDING
  MEMBER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

enum ConnectionStatus {
  PENDING_INSTALLATION
  ACTIVE
  DISCONNECTED
}

// Water Bill and Loan Payment are added in Phases 1B and 1C.
enum PaymentType {
  INSTALLATION_FEE
  MEMBERSHIP_FEE
  OTHER
}

enum PaymentStatus {
  ACTIVE
  VOID
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  accountsCreated Account[]
  paymentsCreated Payment[]  @relation("PaymentCreatedBy")
  paymentsVoided  Payment[]  @relation("PaymentVoidedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

model Area {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  accounts Account[]

  @@map("areas")
}

model Account {
  id            Int     @id @default(autoincrement())
  accountNumber String  @unique @map("account_number")
  // Kept even if the person stops being a member, so the number is never reused.
  memberNumber  String? @unique @map("member_number")
  fullName      String  @map("full_name")
  address       String  @default("")
  areaId        Int     @map("area_id")
  phone         String  @default("")
  birthDate     DateTime?    @map("birth_date") @db.Date
  civilStatus   CivilStatus? @map("civil_status")
  idType        String  @default("") @map("id_type")
  idNumber      String  @default("") @map("id_number")

  // Changed only by the membership service (Make a Member + membership fee payment).
  isMember         Boolean          @default(false) @map("is_member")
  membershipStatus MembershipStatus @default(NONE) @map("membership_status")
  memberSince      DateTime?        @map("member_since") @db.Date
  membershipClass  String?          @map("membership_class")

  createdAt   DateTime @default(now()) @map("created_at")
  createdById Int?     @map("created_by")

  area          Area              @relation(fields: [areaId], references: [id])
  createdBy     User?             @relation(fields: [createdById], references: [id])
  beneficiaries Beneficiary[]
  connections   WaterConnection[]
  payments      Payment[]

  @@index([fullName])
  @@index([areaId])
  @@map("accounts")
}

model Beneficiary {
  id           Int    @id @default(autoincrement())
  accountId    Int    @map("account_id")
  name         String
  relationship String @default("")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model WaterConnection {
  id               Int              @id @default(autoincrement())
  accountId        Int              @map("account_id")
  connectionNumber String           @unique @map("connection_number")
  address          String           @default("")
  rateClass        String           @default("Residential") @map("rate_class")
  installationDate DateTime?        @map("installation_date") @db.Date
  status           ConnectionStatus @default(PENDING_INSTALLATION)
  createdAt        DateTime         @default(now()) @map("created_at")

  account  Account   @relation(fields: [accountId], references: [id])
  payments Payment[]

  @@index([accountId])
  @@map("water_connections")
}

model Payment {
  id          Int           @id @default(autoincrement())
  accountId   Int           @map("account_id")
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  // From IWMPC's own receipt booklet. Entered by hand, required, never reused.
  orNumber    String        @unique @map("or_number")
  // Calendar date in Asia/Manila.
  paymentDate DateTime      @map("payment_date") @db.Date
  // Installation fees are linked to the connection they paid for.
  connectionId Int?         @map("connection_id")
  description String        @default("")
  status      PaymentStatus @default(ACTIVE)
  voidReason  String?       @map("void_reason")
  voidedAt    DateTime?     @map("voided_at")
  voidedById  Int?          @map("voided_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById Int           @map("created_by")

  account    Account          @relation(fields: [accountId], references: [id])
  connection WaterConnection? @relation(fields: [connectionId], references: [id])
  createdBy  User             @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy   User?            @relation("PaymentVoidedBy", fields: [voidedById], references: [id])

  @@index([accountId])
  @@index([paymentDate])
  @@map("payments")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
